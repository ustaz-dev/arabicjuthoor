# Local tool state
.claude/
.agents/
.DS_Store
Thumbs.db
desktop.ini

# Editor/IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Python (used by sister projects)
__pycache__/
*.pyc
.venv/
venv/

# Copyrighted scholar source materials, stay out of the public repo
Data raw/

# Build artifact, generated by _build_og_image.py from og-image.svg
# (committed for now so the deployed site has it; toggle if you regenerate)
# og-image.png
skills-lock.json

# session working dirs (not for publish)
scratch/
temp/
tmp/
outputs/

# Raw research resources (4.5GB dictionaries/corpora; contains a nested git repo)
# tracked exceptions: the index files only
Resources/*
!Resources/README.md
!Resources/manifest.json

# runtime junk
logs/
cache/
.codex-remote-attachments/

# full-coverage sweep: raw lines are too large for git; the denominator lives in data/coverage-summary.json
04-cross-linguistic/data/lane_*_coverage.jsonl
Data raw/coverage/

# lane intermediate scans: candidate enumerations, per-member reviews and ranked reading
# orders. These are the working material behind the cards, not the verdicts, which live in
# 04-cross-linguistic/readings/. One of them is 134 MB, over GitHub's 100 MB hard limit.
# Their SHA-256 fingerprints are committed in data/lane-data-manifest.json, which proves the
# material was not altered without pretending to replace it.
04-cross-linguistic/data/lane_*_scans.jsonl
04-cross-linguistic/data/lane_*_reviews.jsonl
04-cross-linguistic/data/lane_*_inventory.jsonl
04-cross-linguistic/data/lane_c_nucleus_reread_ranked.json
04-cross-linguistic/data/lane_c_ie_week2_members.json
